<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_analytic_history_wizard_form" model="ir.ui.view">
        <field name="name">pos.analytic.history.wizard.form</field>
        <field name="model">pos.analytic.history.wizard</field>
        <field name="arch" type="xml">
            <form string="Apply Analytic to History">
                <group>
                    <field name="config_id" invisible="1"/>
                    <field name="mode" widget="radio"/>
                </group>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

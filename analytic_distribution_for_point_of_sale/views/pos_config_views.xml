<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_config_form_analytic" model="ir.ui.view">
        <field name="name">pos.config.form.analytic</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//setting[@id='other_devices']" position="after">
                <setting id="pos_analytic_accounts"
                         invisible="not analytic_accounting_active">
                    <field name="use_analytic_accounts"
                           help="Enable to distribute POS accounting entries automatically across analytic accounts."/>
                    <div class="content-group">
                        <div class="row mt4">
                            <label for="use_analytic_accounts"
                                   class="col-lg-3 o_light_label"
                                   string="Analytic Accounts"/>
                            <div class="col-lg-9">
                                <button name="action_apply_analytic_to_history"
                                        type="object"
                                        string="Apply to History"
                                        class="btn btn-sm btn-secondary"
                                        invisible="not use_analytic_accounts or not analytic_line_ids"/>
                            </div>
                        </div>
                        <div class="text-muted">
                            Analytic distribution applied automatically to income-statement
                            lines in every accounting entry generated by this POS.
                        </div>
                        <div invisible="not use_analytic_accounts" class="mt-2">
                            <field name="analytic_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="analytic_account_id"
                                           string="Analytic Account"
                                           options="{'no_create_edit': True}"
                                           placeholder="Select analytic account..."/>
                                    <field name="percentage"
                                           string="%"
                                           help="Distribution percentage for this account (0.01 – 100)."/>
                                </list>
                            </field>
                        </div>
                    </div>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>
